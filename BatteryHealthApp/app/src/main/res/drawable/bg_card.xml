<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ColorOS 16 卡片背景：纯白 + 大圆角，阴影由 MaterialCardView elevation 提供 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_solid" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
    <!-- 顶部 1dp 高光，增强层次感 -->
    <item android:top="0.5dp" android:left="0.5dp" android:right="0.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius_card" />
            <stroke
                android:width="0.5dp"
                android:color="#0DFFFFFF" />
        </shape>
    </item>
</layer-list>
