<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- ============================== -->
    <!-- ColorOS 16 页面背景渐变 -->
    <!-- 柔和对角渐变，从纯白到暖灰，营造空间感 -->
    <!-- ============================== -->
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="@color/ios_background_gradient_start"
        android:endColor="@color/ios_background_gradient_end"
        android:centerX="0.3"
        android:centerY="0.7" />
</shape>
