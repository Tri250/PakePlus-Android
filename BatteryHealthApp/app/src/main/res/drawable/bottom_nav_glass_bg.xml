<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 顶部细微分隔线 -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/liquid_glass_border" />
        </shape>
    </item>

    <!-- 液态玻璃主体 -->
    <item
        android:top="0.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/liquid_glass_surface" />
        </shape>
    </item>
</layer-list>
