    <!-- Bugreport 日志抓取引导 -->
    <string name="bugreport_guide_title">Bugreport 日志抓取引导</string>
    <string name="bugreport_guide_subtitle">请按照以下步骤抓取 bugreport 日志，然后跳转到电池健康配置查询</string>
    <string name="bugreport_guide_step1_title">第1步：开启开发者选项</string>
    <string name="bugreport_guide_step1_desc">进入「设置 → 关于手机」，连续点击「版本号」7次，开启开发者选项</string>
    <string name="bugreport_guide_step2_title">第2步：生成Bugreport</string>
    <string name="bugreport_guide_step2_desc">进入「设置 → 开发者选项」，点击「错误报告」或「提交错误报告」，选择「完整报告」</string>
    <string name="bugreport_guide_step3_title">第3步：等待生成完成</string>
    <string name="bugreport_guide_step3_desc">系统将收集日志（约1-3分钟），完成后通知栏会出现报告文件，点击分享或保存</string>
    <string name="bugreport_guide_step4_title">第4步：跳转配置查询</string>
    <string name="bugreport_guide_step4_desc">Bugreport 生成后，可跳转至「电池健康→设备参数」页面查看解析后的电池健康配置</string>
    <string name="bugreport_guide_huawei">华为/荣耀：设置→关于手机→版本号→开发者选项→错误报告→完整报告</string>
    <string name="bugreport_guide_xiaomi">小米/红米：设置→我的设备→全部参数→MIUI版本→开发者选项→错误报告</string>
    <string name="bugreport_guide_oppo">OPPO：设置→关于手机→版本信息→版本号→开发者选项→提交错误报告</string>
    <string name="bugreport_guide_vivo">vivo：设置→更多设置→关于手机→软件版本号→开发者选项→错误报告</string>
    <string name="bugreport_guide_samsung">三星：设置→关于手机→软件信息→版本号→开发者选项→提交错误报告</string>
    <string name="bugreport_guide_brand_title">各品牌操作路径</string>
    <string name="bugreport_guide_action_view">查看引导</string>
    <string name="bugreport_guide_action_close">关闭</string>
