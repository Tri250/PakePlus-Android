<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ============================== -->
    <!-- 应用主题 - V4.4.6 清新绿风格 -->
    <!-- ============================== -->
    <style name="Theme.BatteryHealthApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 主色调 -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryDark">@color/primary_green</item>
        <item name="colorAccent">@color/primary_green</item>
        <item name="colorSecondary">@color/primary_green</item>

        <!-- 背景色 -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>

        <!-- 文字颜色 -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>

        <!-- 状态栏 - 浅色背景深色图标 -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>

        <!-- 导航栏 -->
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- 禁用默认 ActionBar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- 窗口动画 -->
        <item name="android:windowAnimationStyle">@style/AppWindowAnimation</item>
    </style>

    <style name="Theme.BatteryHealthApp.NoActionBar" parent="Theme.BatteryHealthApp">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- ============================== -->
    <!-- 窗口动画 -->
    <!-- ============================== -->
    <style name="AppWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/ios_slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/ios_slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/ios_slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/ios_slide_out_right</item>
    </style>

    <!-- ============================== -->
    <!-- 文本样式 -->
    <!-- ============================== -->
    <style name="AppTitle" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="AppTitle.Large" parent="AppTitle">
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.035</item>
        <item name="android:lineSpacingExtra">6dp</item>
    </style>

    <style name="AppSubtitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="AppBody" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="AppBody.Secondary" parent="AppBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="AppCaption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

    <style name="AppLargeNumber" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:textSize">52sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary_green</item>
        <item name="android:letterSpacing">-0.05</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="AppMediumNumber" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="AppButton" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ============================== -->
    <!-- 列表项与分隔线 -->
    <!-- ============================== -->
    <style name="AppListItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="AppSeparator">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:background">@color/divider</item>
        <item name="android:layout_marginStart">20dp</item>
    </style>

    <!-- ============================== -->
    <!-- Tab 文字 -->
    <!-- ============================== -->
    <style name="AppTabText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/bottom_nav_color</item>
    </style>

    <!-- ============================== -->
    <!-- 旧名称兼容层 -->
    <!-- ============================== -->
    <style name="iOSTitle" parent="AppTitle" />
    <style name="iOSTitle.Large" parent="AppTitle.Large" />
    <style name="iOSSubtitle" parent="AppSubtitle" />
    <style name="iOSBody" parent="AppBody" />
    <style name="iOSBody.Secondary" parent="AppBody.Secondary" />
    <style name="iOSCaption" parent="AppCaption" />
    <style name="iOSLargeNumber" parent="AppLargeNumber" />
    <style name="iOSMediumNumber" parent="AppMediumNumber" />
    <style name="iOSListItem" parent="AppListItem" />
    <style name="iOSSeparator" parent="AppSeparator" />
</resources>
