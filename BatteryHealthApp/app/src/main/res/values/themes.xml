<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ============================== -->
    <!-- 应用主题 - 液态玻璃风格（浅色） -->
    <!-- ============================== -->
    <style name="Theme.BatteryHealthApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 主色调 -->
        <item name="colorPrimary">@color/ios_blue</item>
        <item name="colorPrimaryDark">@color/ios_blue</item>
        <item name="colorAccent">@color/ios_green</item>
        <item name="colorSecondary">@color/ios_blue</item>

        <!-- 背景色 - 使用细腻渐变替代纯色 -->
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:colorBackground">@color/ios_background</item>

        <!-- 文字颜色 -->
        <item name="android:textColorPrimary">@color/ios_label</item>
        <item name="android:textColorSecondary">@color/ios_secondary_label</item>
        <item name="android:textColorTertiary">@color/ios_tertiary_label</item>

        <!-- 状态栏 - 液态玻璃（浅色下用深色图标） -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>

        <!-- 导航栏 - 液态玻璃 -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>



        <!-- 禁用默认 ActionBar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- 液态玻璃窗口动画 -->
        <item name="android:windowAnimationStyle">@style/LiquidGlassWindowAnimation</item>
    </style>

    <style name="Theme.BatteryHealthApp.NoActionBar" parent="Theme.BatteryHealthApp">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- ============================== -->
    <!-- 液态玻璃窗口动画 -->
    <!-- ============================== -->
    <style name="LiquidGlassWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/ios_slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/ios_slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/ios_slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/ios_slide_out_right</item>
    </style>

    <!-- ============================== -->
    <!-- 液态玻璃基础 - 文本样式（被 layout 实际引用） -->
    <!-- ============================== -->
    <style name="LiquidGlassTitle" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ios_label</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="LiquidGlassTitle.Large" parent="LiquidGlassTitle">
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:lineSpacingExtra">6dp</item>
    </style>

    <style name="LiquidGlassSubtitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ios_label</item>
        <item name="android:letterSpacing">-0.022</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="LiquidGlassBody" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ios_label</item>
        <item name="android:letterSpacing">-0.011</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="LiquidGlassBody.Secondary" parent="LiquidGlassBody">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ios_secondary_label</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="LiquidGlassCaption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ios_tertiary_label</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="LiquidGlassLargeNumber" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:textSize">56sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ios_label</item>
        <item name="android:letterSpacing">-0.05</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="LiquidGlassMediumNumber" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ios_label</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="LiquidGlassSmallNumber" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ios_label</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ============================== -->
    <!-- 液态玻璃列表项（View 样式，必须指定 parent） -->
    <!-- 修复：必须显式声明 layout_width/height，否则运行期 InflateException -->
    <!-- ============================== -->
    <style name="LiquidGlassListItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- 修复：必须显式声明 layout_width，否则运行期 InflateException -->
    <style name="LiquidGlassSeparator">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:background">@color/ios_separator</item>
        <item name="android:layout_marginStart">22dp</item>
    </style>

    <!-- ============================== -->
    <!-- 液态玻璃 Tab 文字（被 themes.xml 中 tabTextAppearance 引用） -->
    <!-- ============================== -->
    <!-- 2026-06-18 修复：BottomNavigationView 需要 textColor 属性，否则在某些系统版本抛 Resources$NotFoundException -->
    <style name="LiquidGlassTabText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/bottom_nav_color</item>
    </style>

    <!-- ============================== -->
    <!-- 液态玻璃开关 -->
    <!-- ============================== -->
    <style name="LiquidGlassSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumbTint">@color/white</item>
        <item name="android:trackTint">@color/ios_blue</item>
    </style>

    <!-- ============================== -->
    <!-- 旧名称兼容层（被 layout 实际引用） -->
    <!-- ============================== -->
    <style name="iOSTitle" parent="LiquidGlassTitle" />
    <style name="iOSTitle.Large" parent="LiquidGlassTitle.Large" />
    <style name="iOSCallout" parent="LiquidGlassBody" />
    <style name="iOSSubtitle" parent="LiquidGlassSubtitle" />
    <style name="iOSBody" parent="LiquidGlassBody" />
    <style name="iOSBody.Secondary" parent="LiquidGlassBody.Secondary" />
    <style name="iOSCaption" parent="LiquidGlassCaption" />
    <style name="iOSLargeNumber" parent="LiquidGlassLargeNumber" />
    <style name="iOSMediumNumber" parent="LiquidGlassMediumNumber" />
    <style name="iOSSmallNumber" parent="LiquidGlassSmallNumber" />
    <style name="iOSListItem" parent="LiquidGlassListItem" />
    <style name="iOSSeparator" parent="LiquidGlassSeparator" />
    <style name="iOSSwitch" parent="LiquidGlassSwitch" />
</resources>
