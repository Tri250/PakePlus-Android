<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_background"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="60dp"
        android:paddingBottom="24dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_device_config"
            android:textAppearance="@style/iOSTitle.Large"
            android:letterSpacing="-0.03"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="32dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/liquid_glass_surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="@color/liquid_glass_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_device_info"
                    android:textAppearance="@style/iOSSubtitle"
                    android:paddingTop="22dp"
                    android:paddingBottom="10dp"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp" />

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:minHeight="48dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_device_name"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />
                    <TextView
                        android:id="@+id/tv_device_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:minHeight="48dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_android_version"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />
                    <TextView
                        android:id="@+id/tv_android_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:minHeight="48dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_processor"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />
                    <TextView
                        android:id="@+id/tv_processor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:minHeight="48dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_memory"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />
                    <TextView
                        android:id="@+id/tv_memory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:minHeight="48dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_storage"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />
                    <TextView
                        android:id="@+id/tv_storage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:minHeight="48dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_screen"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />
                    <TextView
                        android:id="@+id/tv_screen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:minHeight="48dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_activation_date"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />
                    <TextView
                        android:id="@+id/tv_activation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:minHeight="48dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_usage_days"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />
                    <TextView
                        android:id="@+id/tv_usage_days"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:minHeight="48dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_activation_source"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />
                    <TextView
                        android:id="@+id/tv_activation_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:minHeight="48dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_available_memory"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />
                    <TextView
                        android:id="@+id/tv_available_memory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:minHeight="48dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_available_storage"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />
                    <TextView
                        android:id="@+id/tv_available_storage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:minHeight="48dp"
                    android:paddingBottom="22dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_network_type"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />
                    <TextView
                        android:id="@+id/tv_network_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/liquid_glass_surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="@color/liquid_glass_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_alert_settings"
                    android:textAppearance="@style/iOSSubtitle"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/health_alert_setting_title"
                            android:textAppearance="@style/iOSBody" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/health_alert_setting_summary"
                            android:textAppearance="@style/iOSBody.Secondary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_health_alert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/iOSSwitch" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/liquid_glass_surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="@color/liquid_glass_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_bugreport"
                    android:textAppearance="@style/iOSSubtitle"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/tv_bugreport_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textAppearance="@style/iOSBody"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_bugreport_dial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textAppearance="@style/iOSBody.Secondary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_bugreport_method"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textAppearance="@style/iOSBody.Secondary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_bugreport_save_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textAppearance="@style/iOSBody.Secondary"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_dial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_open_dial"
                    android:textAppearance="@style/iOSBody"
                    app:backgroundTint="@color/ios_blue"
                    app:cornerRadius="14dp"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_copy_adb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_copy_adb"
                    android:textAppearance="@style/iOSBody"
                    app:backgroundTint="@color/ios_cyan"
                    app:cornerRadius="14dp"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_upload_bugreport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_upload_bugreport"
                    android:textAppearance="@style/iOSBody"
                    app:backgroundTint="@color/ios_green"
                    app:cornerRadius="14dp"
                    app:strokeWidth="0dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/liquid_glass_surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="@color/liquid_glass_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_network_config"
                    android:textAppearance="@style/iOSSubtitle"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/tv_current_base_url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textAppearance="@style/iOSBody.Secondary"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_set_base_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_set_base_url"
                    android:textAppearance="@style/iOSBody"
                    app:backgroundTint="@color/ios_purple"
                    app:cornerRadius="14dp"
                    app:strokeWidth="0dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
