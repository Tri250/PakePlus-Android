<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/liquid_glass_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="0.5dp"
    app:strokeColor="@color/liquid_glass_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <View
            android:id="@+id/view_severity"
            android:layout_width="6dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:background="@color/ios_green" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_result_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ios_label"
                android:textAppearance="@style/iOSBody"
                android:textSize="16sp"
                android:lineSpacingExtra="2dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_result_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ios_secondary_label"
                android:textAppearance="@style/iOSBody.Secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tv_result_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ios_label"
                android:textAppearance="@style/iOSBody"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_result_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:minWidth="48dp"
                android:minHeight="32dp"
                android:gravity="center"
                android:background="@drawable/bg_text_action"
                android:textColor="@color/ios_blue"
                android:textAppearance="@style/iOSBody.Secondary"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
