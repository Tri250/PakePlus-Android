<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="60dp"
        android:paddingBottom="24dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_battery_health"
                android:textAppearance="@style/iOSTitle.Large"
                android:letterSpacing="-0.03"
                android:lineSpacingExtra="6dp"
                android:layout_gravity="start|center_vertical" />

            <LinearLayout
                android:id="@+id/live_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_live_pill"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <View
                    android:id="@+id/live_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_blinking_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_live_monitoring"
                    android:textAppearance="@style/iOSCallout"
                    android:textSize="12sp"
                    android:textColor="@color/ios_green" />

            </LinearLayout>

        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_health"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card_health"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="24dp"
            app:cardElevation="1.5dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="@color/liquid_glass_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal">

                    <com.batteryhealth.app.ui.view.HealthRingView
                        android:id="@+id/health_ring"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:padding="8dp" />

                    <TextView
                        android:id="@+id/tv_health_percentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="--"
                        android:textAppearance="@style/iOSLargeNumber"
                        android:textColor="@color/ios_green" />

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/grade_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_grade_pill"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_grade_dot" />

                    <TextView
                        android:id="@+id/tv_health_grade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSCallout"
                        android:textSize="13sp"
                        android:textColor="@color/white" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_health_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_detecting"
                    android:textAppearance="@style/iOSBody.Secondary"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="12dp" />

                <ProgressBar
                    android:id="@+id/progress_health"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="24dp"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_health" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_calibrate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="校准"
                        android:textAppearance="@style/iOSBody"
                        android:textColor="@color/ios_label"
                        app:backgroundTint="@color/liquid_glass_surface"
                        app:cornerRadius="12dp"
                        app:strokeWidth="0.5dp"
                        app:strokeColor="@color/liquid_glass_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_charging_history"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="充电历史"
                        android:textAppearance="@style/iOSBody"
                        android:textColor="@color/ios_label"
                        app:backgroundTint="@color/liquid_glass_surface"
                        app:cornerRadius="12dp"
                        app:strokeWidth="0.5dp"
                        app:strokeColor="@color/liquid_glass_border" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_weekly_report"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="周报"
                        android:textAppearance="@style/iOSBody"
                        android:textColor="@color/ios_label"
                        app:backgroundTint="@color/liquid_glass_surface"
                        app:cornerRadius="12dp"
                        app:strokeWidth="0.5dp"
                        app:strokeColor="@color/liquid_glass_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_monthly_report"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="月报"
                        android:textAppearance="@style/iOSBody"
                        android:textColor="@color/ios_label"
                        app:backgroundTint="@color/liquid_glass_surface"
                        app:cornerRadius="12dp"
                        app:strokeWidth="0.5dp"
                        app:strokeColor="@color/liquid_glass_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_trend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="趋势"
                        android:textAppearance="@style/iOSBody"
                        android:textColor="@color/ios_label"
                        app:backgroundTint="@color/liquid_glass_surface"
                        app:cornerRadius="12dp"
                        app:strokeWidth="0.5dp"
                        app:strokeColor="@color/liquid_glass_border" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/liquid_glass_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="1.5dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="@color/liquid_glass_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_current_status"
                    android:textAppearance="@style/iOSSubtitle"
                    android:paddingTop="22dp"
                    android:paddingBottom="10dp"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp" />

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_battery_level"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_battery_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--%"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_charging_status"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_charging_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_current"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_current_now"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- mA"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/liquid_glass_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="1.5dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="@color/liquid_glass_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_details"
                    android:textAppearance="@style/iOSSubtitle"
                    android:paddingTop="22dp"
                    android:paddingBottom="10dp"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp" />

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_battery_capacity"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_capacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_cycle_count"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_cycle_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_battery_temperature"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_battery_voltage"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_voltage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_battery_source"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_battery_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_battery_technology"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_technology"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/liquid_glass_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="1.5dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="@color/liquid_glass_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_settings"
                    android:textAppearance="@style/iOSSubtitle"
                    android:paddingTop="22dp"
                    android:paddingBottom="10dp"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp" />

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_show_background_notification"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_notification"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
