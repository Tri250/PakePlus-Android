<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk-res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="60dp"
        android:paddingBottom="24dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/tv_device_model_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_device_model"
            android:textAppearance="@style/AppTitle.Large"
            android:letterSpacing="-0.03"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_beyond_devices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/beyond_devices_format"
            android:textAppearance="@style/AppBody.Secondary"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_health"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_health_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textAppearance="@style/AppLargeNumber"
                    android:textColor="@color/primary_green" />

                <TextView
                    android:id="@+id/tv_health_grade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textAppearance="@style/AppMediumNumber"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tv_health_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_detecting"
                    android:textAppearance="@style/AppBody.Secondary"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="8dp" />

                <ProgressBar
                    android:id="@+id/progress_health"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="24dp"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_health" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_current_status"
                    android:textAppearance="@style/AppSubtitle"
                    android:paddingTop="22dp"
                    android:paddingBottom="10dp"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp" />

                <View style="@style/AppSeparator" />

                <LinearLayout
                    style="@style/AppListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_battery_level"
                        android:textAppearance="@style/AppBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_battery_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--%"
                        android:textAppearance="@style/AppBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/AppSeparator" />

                <LinearLayout
                    style="@style/AppListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_charging_status"
                        android:textAppearance="@style/AppBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_charging_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/AppBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/AppSeparator" />

                <LinearLayout
                    style="@style/AppListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_current"
                        android:textAppearance="@style/AppBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_current_now"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- mA"
                        android:textAppearance="@style/AppBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_details"
                    android:textAppearance="@style/AppSubtitle"
                    android:paddingTop="22dp"
                    android:paddingBottom="10dp"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp" />

                <View style="@style/AppSeparator" />

                <LinearLayout
                    style="@style/AppListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_battery_capacity"
                        android:textAppearance="@style/AppBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_capacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/AppBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/AppSeparator" />

                <LinearLayout
                    style="@style/AppListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_cycle_count"
                        android:textAppearance="@style/AppBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_cycle_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/AppBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/AppSeparator" />

                <LinearLayout
                    style="@style/AppListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_battery_temperature"
                        android:textAppearance="@style/AppBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/AppBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/AppSeparator" />

                <LinearLayout
                    style="@style/AppListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_battery_voltage"
                        android:textAppearance="@style/AppBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_voltage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/AppBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/AppSeparator" />

                <LinearLayout
                    style="@style/AppListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_battery_source"
                        android:textAppearance="@style/AppBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_battery_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/AppBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/AppSeparator" />

                <LinearLayout
                    style="@style/AppListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_battery_technology"
                        android:textAppearance="@style/AppBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_technology"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/AppBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_aging_prediction"
                    android:textAppearance="@style/AppSubtitle"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_aging_prediction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aging_prediction_unavailable"
                    android:textAppearance="@style/AppBody"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    android:id="@+id/tv_source_explanation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/what_does_this_mean"
                    android:textAppearance="@style/AppBody"
                    android:textColor="@color/primary_green"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_mini_trend"
                    android:textAppearance="@style/AppSubtitle"
                    android:layout_marginBottom="14dp" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_health_trend"
                    android:layout_width="match_parent"
                    android:layout_height="120dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_history"
                    android:textAppearance="@style/AppSubtitle"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:id="@+id/layout_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_history_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_empty"
                    android:textAppearance="@style/AppBody.Secondary"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_reports"
                    android:textAppearance="@style/AppSubtitle"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_weekly_report"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/btn_weekly_report"
                        android:textAppearance="@style/AppButton"
                        android:textSize="14sp"
                        app:backgroundTint="@color/primary_green"
                        app:cornerRadius="24dp"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_monthly_report"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/btn_monthly_report"
                        android:textAppearance="@style/AppButton"
                        android:textSize="14sp"
                        app:backgroundTint="@color/primary_green"
                        app:cornerRadius="24dp"
                        app:strokeWidth="0dp" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_trend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_trend"
                    android:textAppearance="@style/AppButton"
                    android:textSize="14sp"
                    app:backgroundTint="@color/primary_green"
                    app:cornerRadius="24dp"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_endurance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_endurance"
                    android:textAppearance="@style/AppButton"
                    android:textSize="14sp"
                    app:backgroundTint="@color/primary_green"
                    app:cornerRadius="24dp"
                    app:strokeWidth="0dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
