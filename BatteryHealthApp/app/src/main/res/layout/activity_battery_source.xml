<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/page_padding_top"
        android:paddingBottom="@dimen/page_padding_bottom"
        android:paddingStart="@dimen/page_padding_horizontal"
        android:paddingEnd="@dimen/page_padding_horizontal">

        <!-- 顶部返回栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_battery"
                android:contentDescription="@string/action_back"
                app:tint="@color/label" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/title_battery_source"
                android:textAppearance="@style/WebPageTitle"
                android:textSize="28sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_battery_source"
            android:textAppearance="@style/WebPageSubtitle"
            android:layout_marginBottom="22dp" />

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="40dp" />

        <!-- 最终结果卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_margin_bottom"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_source_result"
                    android:textSize="14sp"
                    android:textColor="@color/label_3" />

                <TextView
                    android:id="@+id/tv_final_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tv_confidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tv_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="14sp"
                    android:textColor="@color/label_2"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 判断依据 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_source_criteria"
            android:textAppearance="@style/WebSectionEyebrow"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_margin_bottom"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card">

                <LinearLayout style="@style/iOSListItem" android:minHeight="48dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/label_psn_match" android:textAppearance="@style/WebListLabel" />
                    <TextView android:id="@+id/tv_psn_match" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textAppearance="@style/WebListValue" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout style="@style/iOSListItem" android:minHeight="48dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/label_factory_serial" android:textAppearance="@style/WebListLabel" />
                    <TextView android:id="@+id/tv_factory_serial" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textAppearance="@style/WebListValue" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout style="@style/iOSListItem" android:minHeight="48dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/label_capacity_match" android:textAppearance="@style/WebListLabel" />
                    <TextView android:id="@+id/tv_capacity_match" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textAppearance="@style/WebListValue" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout style="@style/iOSListItem" android:minHeight="48dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/label_cycle_range" android:textAppearance="@style/WebListLabel" />
                    <TextView android:id="@+id/tv_cycle_range" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textAppearance="@style/WebListValue" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout style="@style/iOSListItem" android:minHeight="48dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/label_health_drop" android:textAppearance="@style/WebListLabel" />
                    <TextView android:id="@+id/tv_health_drop" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textAppearance="@style/WebListValue" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 电池信息 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_battery_info"
            android:textAppearance="@style/WebSectionEyebrow"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_margin_bottom"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card">

                <LinearLayout style="@style/iOSListItem" android:minHeight="48dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/label_manufacturer" android:textAppearance="@style/WebListLabel" />
                    <TextView android:id="@+id/tv_manufacturer" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textAppearance="@style/WebListValue" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout style="@style/iOSListItem" android:minHeight="48dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/label_battery_serial" android:textAppearance="@style/WebListLabel" />
                    <TextView android:id="@+id/tv_serial_number" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textAppearance="@style/WebListValue" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout style="@style/iOSListItem" android:minHeight="48dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/label_design_capacity" android:textAppearance="@style/WebListLabel" />
                    <TextView android:id="@+id/tv_design_capacity" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textAppearance="@style/WebListValue" />
                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout style="@style/iOSListItem" android:minHeight="48dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/label_full_capacity" android:textAppearance="@style/WebListLabel" />
                    <TextView android:id="@+id/tv_full_capacity" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textAppearance="@style/WebListValue" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
