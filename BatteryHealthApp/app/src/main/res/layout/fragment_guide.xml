<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_bugreport_guide"
            android:textAppearance="@style/WebPageTitle"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_bugreport_guide"
            android:textAppearance="@style/WebPageSubtitle"
            android:layout_marginBottom="24dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_solid"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="@dimen/elevation_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_upload_bugreport"
                    android:textAppearance="@style/WebCardHeader"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/desc_upload_bugreport"
                    android:textAppearance="@style/WebListValue"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btn_upload_bugreport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_upload_bugreport"
                    android:textAppearance="@style/WebCardHeader"
                    android:background="@drawable/bg_btn_primary"
                    android:textColor="@color/white"
                    android:padding="12dp"/>

                <TextView
                    android:id="@+id/tv_analysis_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/WebListLabel"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_solid"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="@dimen/elevation_card">

            <LinearLayout
                android:id="@+id/guide_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_solid"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="@dimen/elevation_card">

            <LinearLayout
                android:id="@+id/analysis_result_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"/>

        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
