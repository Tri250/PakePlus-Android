<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="60dp"
        android:paddingBottom="24dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_endurance"
            android:textAppearance="@style/iOSTitle.Large"
            android:letterSpacing="-0.03"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="32dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/liquid_glass_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="1.5dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="@color/liquid_glass_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_estimated_endurance"
                    android:textAppearance="@style/iOSBody.Secondary"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tv_endurance_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hours_placeholder"
                    android:textAppearance="@style/iOSLargeNumber"
                    android:textColor="@color/ios_green" />

                <TextView
                    android:id="@+id/tv_endurance_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_calculating"
                    android:textAppearance="@style/iOSCaption"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/liquid_glass_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="1.5dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="@color/liquid_glass_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_cluster_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--%"
                        android:textAppearance="@style/iOSMediumNumber"
                        android:textColor="@color/ios_label" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_current_level"
                        android:textAppearance="@style/iOSCallout"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

                <View
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"
                    android:background="@color/ios_separator" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_cluster_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSMediumNumber"
                        android:textColor="@color/ios_label" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_discharge_rate"
                        android:textAppearance="@style/iOSCallout"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

                <View
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"
                    android:background="@color/ios_separator" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_cluster_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--°C"
                        android:textAppearance="@style/iOSMediumNumber"
                        android:textColor="@color/ios_label" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_battery_temperature"
                        android:textAppearance="@style/iOSCallout"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/liquid_glass_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="1.5dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="@color/liquid_glass_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_battery_usage_details"
                    android:textAppearance="@style/iOSSubtitle"
                    android:paddingTop="22dp"
                    android:paddingBottom="10dp"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp" />

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_current_level"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_current_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--%"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_discharge_rate"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_discharge_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--%/h"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_charging_status"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_charge_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_battery_temperature"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_battery_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--°C"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <View style="@style/iOSSeparator" />

                <LinearLayout
                    style="@style/iOSListItem"
                    android:minHeight="48dp"
                    android:paddingBottom="22dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_estimated_full"
                        android:textAppearance="@style/iOSBody"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tv_full_charge_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/iOSBody.Secondary"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/liquid_glass_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="1.5dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="@color/liquid_glass_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_top_consumers"
                    android:textAppearance="@style/iOSSubtitle"
                    android:paddingBottom="12dp" />

                <TextView
                    android:id="@+id/tv_consumption_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_data_collecting"
                    android:textAppearance="@style/iOSBody.Secondary"
                    android:paddingBottom="12dp" />

                <TextView
                    android:id="@+id/tv_consumption_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/iOSBody"
                    android:lineSpacingExtra="6dp" />

                <TextView
                    android:id="@+id/tv_consumption_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_no_usage_data"
                    android:textAppearance="@style/iOSBody.Secondary"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
