<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_battery_3d" />

    <TextView
        android:id="@+id/onboard_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="@string/onboard_title_1"
        android:textColor="@color/label"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/onboard_item_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:alpha="0.7"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/onboard_subtitle_1"
        android:textColor="@color/label_2"
        android:textSize="15sp" />
</LinearLayout>
