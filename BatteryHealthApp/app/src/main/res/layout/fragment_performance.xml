<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_background"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="60dp"
        android:paddingBottom="24dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- 页面标题 - iOS 2026风格 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="性能分析"
            android:textAppearance="@style/iOSTitle.Large"
            android:letterSpacing="-0.03"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="32dp" />

        <!-- CPU使用率卡片 - iOS 2026风格 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/ios_secondary_background"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CPU使用率"
                    android:textAppearance="@style/iOSSubtitle"
                    android:letterSpacing="-0.01"
                    android:lineSpacingExtra="3dp" />

                <!-- CPU数值 - iOS 2026风格 -->
                <TextView
                    android:id="@+id/tv_cpu_usage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textAppearance="@style/iOSMediumNumber"
                    android:textColor="@color/ios_blue"
                    android:letterSpacing="-0.03"
                    android:layout_marginTop="16dp" />

                <!-- CPU进度条 -->
                <ProgressBar
                    android:id="@+id/progress_cpu"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="16dp"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_health" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 内存使用率卡片 - iOS 2026风格 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/ios_secondary_background"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="内存使用率"
                    android:textAppearance="@style/iOSSubtitle"
                    android:letterSpacing="-0.01"
                    android:lineSpacingExtra="3dp" />

                <!-- 内存数值 - iOS 2026风格 -->
                <TextView
                    android:id="@+id/tv_memory_usage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textAppearance="@style/iOSMediumNumber"
                    android:textColor="@color/ios_green"
                    android:letterSpacing="-0.03"
                    android:layout_marginTop="16dp" />

                <!-- 内存进度条 -->
                <ProgressBar
                    android:id="@+id/progress_memory"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="16dp"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_health" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>