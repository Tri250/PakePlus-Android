    <style name="WebBadge" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_badge</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label_2</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WebTabLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_tab_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label_2</item>
        <item name="android:fontFamily">sans-serif-medium</item>
