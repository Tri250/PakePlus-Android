<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 暗色主题：覆盖Material主题颜色 -->
    <style name="Theme.BatteryHealthApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ios_blue</item>
        <item name="colorPrimaryVariant">@color/ios_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ios_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/ios_background</item>
        <item name="android:statusBarColor">@color/ios_background</item>
        <item name="android:navigationBarColor">@color/ios_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorSurface">@color/liquid_glass_surface</item>
        <item name="colorOnSurface">@color/label</item>
        <item name="colorError">@color/ios_red</item>
        <item name="android:textColorPrimary">@color/label</item>
        <item name="android:textColorSecondary">@color/label_2</item>
    </style>
</resources>