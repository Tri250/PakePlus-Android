<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ============================== -->
    <!-- 应用主题 - Web Design System（深色） -->
    <!-- ============================== -->
    <style name="Theme.BatteryHealthApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 主色调 -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primaryVariant</item>
        <item name="colorAccent">@color/green</item>
        <item name="colorSecondary">@color/secondary</item>

        <!-- 背景色 -->
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:colorBackground">@color/bg_canvas</item>

        <!-- 文字颜色 -->
        <item name="android:textColorPrimary">@color/label</item>
        <item name="android:textColorSecondary">@color/label_2</item>
        <item name="android:textColorTertiary">@color/label_3</item>

        <!-- 状态栏 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>

        <!-- 导航栏 -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <!-- 禁用默认 ActionBar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- 窗口动画 -->
        <item name="android:windowAnimationStyle">@style/LiquidGlassWindowAnimation</item>
    </style>

    <style name="Theme.BatteryHealthApp.NoActionBar" parent="Theme.BatteryHealthApp">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- ============================== -->
    <!-- 窗口动画 -->
    <!-- ============================== -->
    <style name="LiquidGlassWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/ios_slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/ios_slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/ios_slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/ios_slide_out_right</item>
    </style>

    <!-- ============================== -->
    <!-- Web Design System - 文本样式 -->
    <!-- ============================== -->
    <style name="WebPageTitle" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">@dimen/text_page_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WebPageSubtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_page_subtitle</item>
        <item name="android:textColor">@color/label_2</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="WebCardHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_card_header</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WebCardEyebrow" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textSize">@dimen/text_card_eyebrow</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label_3</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WebListLabel" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_list_label</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="WebListValue" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_list_value</item>
        <item name="android:textColor">@color/label_2</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="WebRingPercent" parent="TextAppearance.MaterialComponents.Headline2">
