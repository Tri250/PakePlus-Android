        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:letterSpacing">-0.05</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WebWatt" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textSize">@dimen/text_watt</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:letterSpacing">-0.05</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WebUnit" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_unit</item>
        <item name="android:textStyle">bold</item>
