<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 应用主题 - iOS 2026风格 深色模式 -->
    <style name="Theme.BatteryHealthApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 主色调 -->
        <item name="colorPrimary">@color/ios_blue</item>
        <item name="colorPrimaryDark">@color/ios_blue</item>
        <item name="colorAccent">@color/ios_green</item>
        
        <!-- 背景色 -->
        <item name="android:windowBackground">@color/ios_background</item>
        <item name="android:colorBackground">@color/ios_background</item>
        
        <!-- 文字颜色 -->
        <item name="android:textColorPrimary">@color/ios_label</item>
        <item name="android:textColorSecondary">@color/ios_secondary_label</item>
        
        <!-- 状态栏 -->
        <item name="android:statusBarColor">@color/ios_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        
        <!-- 导航栏 -->
        <item name="android:navigationBarColor">@color/ios_background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        
        <!-- 禁用默认ActionBar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        
        <!-- iOS 2026动画效果 -->
        <item name="android:windowAnimationStyle">@style/iOSWindowAnimation</item>
        
        <!-- Android 15 临时禁用强制edge-to-edge，避免系统栏覆盖内容 -->
        <item name="android:windowOptOutEdgeToEdge">true</item>
    </style>
    
    <!-- 无ActionBar主题 - 继承自主主题 -->
    <style name="Theme.BatteryHealthApp.NoActionBar" parent="Theme.BatteryHealthApp">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- iOS 2026风格开关 - 深色模式 -->
    <style name="iOSSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumbTint">@color/white</item>
        <item name="android:trackTint">@color/ios_tertiary_background</item>
        <item name="android:backgroundTint">@color/ios_blue</item>
    </style>
</resources>