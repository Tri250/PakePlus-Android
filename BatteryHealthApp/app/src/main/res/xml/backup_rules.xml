<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for the app
-->
<full-backup-content>
    <include domain="sharedpref" path="."/>
    <exclude domain="sharedpref" path="device.xml"/>
    <!-- 加密密钥文件禁止备份，否则跨设备恢复后数据库无法解密 -->
    <exclude domain="sharedpref" path="battery_db_key_prefs.xml"/>
    <exclude domain="sharedpref" path="battery_db_key_prefs_plain.xml"/>
</full-backup-content>