<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- 存储权限 - Android 13+使用新的媒体权限 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    
    <!-- 设备信息权限：仅 Android 9 及以下需要 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"
        android:maxSdkVersion="28" />
    
    <!-- 前台服务权限 (用于实时监测) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    
    <!-- 唤醒权限 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Android 13+ 通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 电池优化白名单（用于自检模块一键修复） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BatteryHealthApp"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:name=".BatteryHealthApplication"
        tools:targetApi="36">
        
        <activity
            android:name=".ui.bugreport.BugreportGuideActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.BatteryHealthApp.NoActionBar"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:enableOnBackInvokedCallback="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.BatteryHealthApp.NoActionBar"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:enableOnBackInvokedCallback="true" />

        <activity
            android:name=".ui.source.BatterySourceActivity"
            android:exported="false"
            android:theme="@style/Theme.BatteryHealthApp.NoActionBar" />

        <activity
            android:name=".ui.battery.ReportActivity"
            android:exported="false"
            android:theme="@style/Theme.BatteryHealthApp.NoActionBar" />

        <activity
            android:name=".ui.error.ErrorActivity"
            android:exported="false"
            android:theme="@style/Theme.BatteryHealthApp.NoActionBar" />

        <activity
            android:name=".ui.policy.PolicyActivity"
            android:exported="false"
            android:theme="@style/Theme.BatteryHealthApp.NoActionBar" />

        <activity
            android:name=".ui.trend.TrendActivity"
            android:exported="false"
            android:theme="@style/Theme.BatteryHealthApp.NoActionBar" />

        <activity
            android:name=".ui.healthcheck.HealthCheckActivity"
            android:exported="false"
            android:theme="@style/Theme.BatteryHealthApp.NoActionBar" />

        <!-- 电池监测服务：兼容低版本仅声明 dataSync，health 类型在代码中按 API 动态添加 -->
        <service
            android:name=".service.BatteryMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 充电监测服务 -->
        <service
            android:name=".service.ChargingMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- FileProvider：用于分享导出的 CSV 文件 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>