# =============================================================================
# Release签名配置文件示例
# 正式发版前请复制此文件为 keystore.properties 并填写真实信息
# =============================================================================

# Keystore文件路径（相对于项目根目录）
storeFile=release-keystore.jks

# Keystore密码
storePassword=your_keystore_password

# 密钥别名
keyAlias=your_key_alias

# 密钥密码
keyPassword=your_key_password
