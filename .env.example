# 2026 年免费地图服务配置
# 复制此文件为 .env.local 并填入你的 API Key

# ========================================
# 完全免费（无需 Key）
# ========================================
# OpenStreetMap / Nominatim - 完全免费，1 QPS
# 无需配置，直接使用

# ========================================
# 免费 Tier（需要注册获取 Key）
# ========================================

# Mapbox - 免费 50K 请求/月
# 注册：https://www.mapbox.com/
VITE_MAPBOX_KEY=

# HERE - 免费 250K 事务/月
# 注册：https://developer.here.com/
VITE_HERE_KEY=

# LocationIQ - 免费 5K 请求/天
# 注册：https://locationiq.com/
VITE_LOCATIONIQ_KEY=

# MapTiler - 免费 100K 请求/月
# 注册：https://www.maptiler.com/
VITE_MAPTILER_KEY=

# ========================================
# 国内地图服务（需要 Key）
# ========================================

# 高德地图 Web API
# 注册：https://lbs.amap.com/
VITE_AMAP_KEY=

# 腾讯位置服务
# 注册：https://lbs.qq.com/
VITE_TENCENT_KEY=

# ========================================
# 品牌数据 API
# ========================================

# 品牌 CRM API 基础 URL
VITE_CRM_API_URL=

# 品牌数据同步密钥
VITE_CRM_SYNC_KEY=

# ========================================
# AI 服务
# ========================================

# DeepSeek API
VITE_DEEPSEEK_KEY=

# 腾讯混元 API
VITE_HUNYUAN_KEY=
