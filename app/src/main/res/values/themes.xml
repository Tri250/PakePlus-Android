<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 掌上商客主题 - 科技蓝紫风格 -->
    <style name="Theme.HandBizRadar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 品牌主色 -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- 辅助色 -->
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSecondaryVariant">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- 状态栏 -->
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <!-- 错误色 -->
        <item name="colorError">@color/status_danger</item>
        <!-- 背景色 -->
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.HandBizRadar.NoActionBar" parent="Theme.HandBizRadar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.HandBizRadar.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.HandBizRadar.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
